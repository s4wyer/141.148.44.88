[Unit]
Description=141.148.44.88 Brutalist Tools
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brutalist
Group=brutalist
WorkingDirectory=/opt/brutalist-tools
EnvironmentFile=-/opt/brutalist-tools/.env
ExecStart=/opt/brutalist-tools/brutalist-tools
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/brutalist-tools

[Install]
WantedBy=multi-user.target

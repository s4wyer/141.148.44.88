	auto_https disable_redirects
	default_sni 141.148.44.88
}

(app_proxy) {
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-Client-IP {remote_host}
		flush_interval -1
	}
}

https://141.148.44.88 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import app_proxy
}

:80 {
	import app_proxy
}
